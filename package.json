{
  "name": "roomify-ai",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "demo": "concurrently -k -n api,web \"node --watch server/index.ts --demo\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "compilar:escritorio": "esbuild desktop/main.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --external:sharp --outfile=desktop-dist/main.cjs",
    "escritorio": "npm run build && npm run compilar:escritorio && electron .",
    "empaquetar": "npm run build && npm run compilar:escritorio && electron-builder --win portable"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "description": "De plano 2D a render 3D con IA",
  "author": "Srsovietic1052313",
  "main": "desktop-dist/main.cjs",
  "build": {
    "appId": "com.srsovietic.roomify",
    "productName": "Roomify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop-dist/**",
      "recursos/icono.ico"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "win": {
      "target": "portable",
      "icon": "recursos/icono.ico"
    },
    "portable": {
      "artifactName": "Roomify.exe"
    }
  }
}
